# ECS private config example.
# Copy this file to /root/browser-ai-relay/deploy/ecs/release-meta.env on ECS.
# Never commit the real release-meta.env or runtime.env.

GHCR_BASE=ghcr.io/huozao
COMPOSE_FILE=/root/browser-ai-relay/deploy/ecs/compose.prod.yml
RUNTIME_ENV_FILE=/root/browser-ai-relay/deploy/ecs/runtime.env
METADATA_DIR=/root/browser-ai-relay/deploy/ecs/.release
DEPLOY_LOG_DIR=/root/browser-ai-relay/deploy/ecs/logs

# Required if the GHCR package is private. Use a PAT with read:packages.
GHCR_USERNAME=
GHCR_TOKEN=

HEALTHCHECK_URL=http://127.0.0.1:18000/healthz
HEALTHCHECK_RETRIES=30
HEALTHCHECK_INTERVAL_SECONDS=5

APP_ENV=prod
API_TOKEN=replace_with_long_random_api_token
# VNC protocol authentication commonly uses only the first 8 chars.
# Keep this value 8 chars or shorter. It is for noVNC only, not API auth.
VNC_PASSWORD=changeme

HOST_API_BIND=127.0.0.1
HOST_API_PORT=18000
HOST_NOVNC_BIND=127.0.0.1
HOST_NOVNC_PORT=6080
HOST_BROWSER_DATA_DIR=/root/browser-ai-relay-data/browser_data
HOST_LOGS_DIR=/root/browser-ai-relay-data/logs

BROWSER_MODE=ecs_cdp
CDP_URL=http://127.0.0.1:9222
CDP_CONNECT_TIMEOUT_SECONDS=60
ATTACH_ON_START=false

CHATGPT_URL=https://chatgpt.com/
CHAT_TIMEOUT_SECONDS=120
RESPONSE_STABLE_SECONDS=5

ENABLE_STEALTH=true
SLOW_MO_MS=50
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
VIEWPORT_JITTER_PX=20
BROWSER_CHANNEL=chrome
BEFORE_TYPE_DELAY_MIN_MS=500
BEFORE_TYPE_DELAY_MAX_MS=1200
BEFORE_SEND_DELAY_MIN_MS=300
BEFORE_SEND_DELAY_MAX_MS=600
TYPING_DELAY_MIN_MS=0
TYPING_DELAY_MAX_MS=0
LOG_LEVEL=INFO

COMPOSE_PROJECT_NAME=browser-ai-relay
